# ==========================================
# ИНИЦИАЛИЗАЦИЯ ПЕРСОНАЖЕЙ И ПЕРЕМЕННЫХ
# ==========================================

# Цвета персонажей
define v = Character("Валера", color="#c8ffc8")
define c = Character("Рыжий Кот", color="#ff8c00")
define g = Character("Гусеница Bugatti", color="#8a2be2")
define glas = Character("Голос сверху", color="#aaaaaa")

# Переменные для монет и предметов
default coins = 0
default has_svidetelstvo = False
default has_zayavlenie_deti = False
default has_zayavlenie_keshbek = False

# ==========================================
# ЗАГРУЗКА ИЗОБРАЖЕНИЙ (Замени на свои файлы)
# ==========================================
# Фоны
image bg office = "images/bg_office.png"
image bg documents = "images/bg_documents.png"
image bg road = "images/bg_road.png"
image bg fair = "images/bg_fair.png"
image bg booth = "images/bg_booth.png"
image bg stairs = "images/bg_stairs.png"
image bg cabinet = "images/bg_cabinet.png"
image bg realty = "images/bg_realty.png"
image bg garage = "images/bg_garage.png"
image bg forest = "images/bg_forest.png"
image bg gto = "images/bg_gto.png"
image bg social_forest = "images/bg_social_forest.png"
image bg archive = "images/bg_archive.png"
image bg palace = "images/bg_palace.png"
image bg final = "images/bg_final.png"

# Спрайты персонажей (можно использовать частично)
image cat smile = "images/cat_smile.png"
image cat full = "images/cat_full.png"
image caterpillar = "images/caterpillar.png"

# ==========================================
# НАЧАЛО ИГРЫ
# ==========================================
label start:
    scene bg office
    with fade
    
    "Обычный опенспейс, вечер пятницы. На экране Валеры всплывает файл «Налоговый_вычет.exe» с подмигивающей иконкой."
    
    v "Хм, что это ещё за файл? Я такой не сохранял..."
    
    "Клик. Экран темнеет, пол уходит из-под ног. Валера падает — мимо пролетают квитанции, справки 2-НДФЛ, бланки деклараций 3-НДФЛ, монетки с чьим-то рыжим профилем."
    
    glas "Падать вечно нельзя, дружок. Рано или поздно долетишь до сути."
    
    scene bg documents
    with fade
    
    "Валера приземляется на мягкую кипу документов. В воздухе постепенно проявляется улыбка — а затем и весь Рыжий Кот, вальяжно развалившийся на ветке."
    
    show cat smile
    c "Добро пожаловать в Страну Налогов, Валера. Тут всё как у вас, только выгоднее — если знать, куда смотреть."
    
    v "Погоди, а ты кто? И где я?"
    
    c "Я — тот, кто всегда рядом, даже когда меня не видно. А ты — там, где государство наконец готово вернуть тебе твои же деньги. Осталось только не упустить момент."
    
    v "Звучит подозрительно просто."
    
    c "О, поверь, бюрократии тут хватало. Но с 2024 года многое изменилось — карту почитай."
    
    # ВЫБОР 1
    label prologue_choice:
        menu:
            "Что спросит Валера?"
            
            "А зачем мне вообще это надо, я и так неплохо живу":
                c "Неплохо — не значит по максимуму. Тысячи рублей просто лежат там, где ты их не забираешь."
                jump prologue_choice
                
            "А можно получить вычет, если я вообще ничего не тратил?":
                c "Вычет — это возврат уже уплаченного налога с твоих трат. Не потратил — нечего возвращать. Но ты наверняка тратился — на детей, лечение, учёбу..."
                jump prologue_choice
                
            "Хорошо, показывай дорогу":
                c "Тогда за мной. Первая остановка — Родительский лес."
                $ coins += 10
                jump prologue_rule

label prologue_rule:
    "🪙 +10 монет любопытства"
    
    scene bg road
    with dissolve
    
    "Кот останавливается на развилке дорог и разворачивается к Валере, прежде чем идти дальше."
    
    c "Погоди-ка, прежде чем мы пойдём глубже — запомни одну вещь, а то потом собьёшься со счёта."
    v "Какую?"
    
    c "Из каждого рубля твоей зарплаты налоговая ещё до того, как деньги попадут к тебе, забирает 13 копеек — это налог на доходы. Вычет — это не деньги, которые тебе дарят сверху. Это сумма, с которой налоговая обещает не забирать свои 13 копеек."
    
    show caterpillar
    g "Проще говоря: вычет 100 000 ₽ — вернётся 13 000 ₽. Вычет 150 000 ₽ — вернётся 19 500 ₽. Всегда 13% от вычета, а не сам вычет целиком."
    
    v "То есть когда я слышу «вычет 150 000», это не 150 000 рублей мне на карту?"
    
    g "Именно так, дружочек. И ещё: получить вычет может только тот, кто платит НДФЛ 13% — то есть официально работает. Самозанятые и ИП на УСН в этой сказке, увы, не участвуют."
    
    # ВЫБОР 2
    label prologue_math:
        menu:
            "Валере положен вычет 150 000 ₽ на лечение. Сколько реально вернётся ему на счёт?"
            
            "150 000 ₽":
                c "Это база, а не возврат. Пересчитай через 13%."
                jump prologue_math
                
            "13 000 ₽":
                g "Это 13% от 100 000, а у нас 150 000."
                jump prologue_math
                
            "19 500 ₽":
                c "Вот теперь считаешь правильно. 150 000 × 13% = 19 500 ₽."
                $ coins += 15
                jump prologue_end

label prologue_end:
    "🪙 +15 монет · получено правило «Вычет = база, а не возврат»"
    
    c "И да — с 2025 года ставка НДФЛ не всегда ровно 13%. При высоком доходе она растёт по прогрессивной шкале, до 22%. Так что у некоторых счастливчиков реальный возврат может быть даже больше стандартных 13% от вычета."
    jump block_1

# ==========================================
# БЛОК 1. ЯРМАРКА НА ПОЛЯНЕ НДФЛ
# ==========================================
label block_1:
    scene bg fair
    with fade
    
    "Шумная ярмарка. У каждого прилавка — своя табличка: «Зарплата», «Аренда», «Продажа», «Выигрыш», «Дивиденды». Каждый прилавок время от времени сам бросает монетку в большой мешок с гербом посередине площади."
    
    show cat full at left
    c "Добро пожаловать на Ярмарку НДФЛ. Это главный налог, который касается тебя каждый месяц, даже если ты о нём не думаешь."
    
    v "А что вообще под него попадает? Только зарплата?"
    
    show caterpillar at right
    g "О, гораздо больше, мой дорогой. Зарплата, премии, доход от сдачи квартиры в аренду, продажа имущества, выигрыши, дивиденды по акциям — всё это доход, а с дохода физлица берут НДФЛ."
    
    # ВЫБОР 3
    label block1_choice1:
        menu:
            "Валера в отпуске выиграл в лотерею 50 000 ₽. Нужно ли платить с этого НДФЛ?"
            
            "Нет, это же не зарплата":
                c "Прилавок с выигрышами тоже кидает монетку в мешок, не сомневайся."
                jump block1_choice1
                
            "Только если выигрыш больше 1 000 000 ₽":
                g "Не совсем так работает порог, дружочек. Выигрыш облагается налогом почти всегда."
                jump block1_choice1
                
            "Да, это тоже доход — и с него тоже удерживается налог":
                g "Именно. Доход есть доход, откуда бы он ни пришёл."
                $ coins += 15
                jump block1_scene2

label block1_scene2:
    "🪙 +15 монет"
    
    scene bg booth
    with dissolve
    
    "Небольшая деревянная будка с окошком, из которого молча высовывается рука и забирает часть монет ещё до того, как они попадают в карман Валеры."
    
    c "Видишь эту будку? Это твой работодатель — он тут называется налоговым агентом."
    v "В смысле, налоговым агентом? Он же просто платит мне зарплату."
    
    c "И одновременно сам удерживает налог и перечисляет его в бюджет — тебе для этого ничего подавать не нужно. С зарплаты всё происходит автоматически."
    
    g "А вот с другими доходами — не так. Если сдаёшь квартиру и деньги идут прямо тебе на карту, никто за тебя налог не удержит. Придётся подавать декларацию 3-НДФЛ самостоятельно, по итогам года."
    
    # ВЫБОР 4
    label block1_choice2:
        menu:
            "Валера сдаёт квартиру в аренду, деньги приходят напрямую ему на карту. Что делать с налогом?"
            
            "Ничего, раз с зарплаты уже всё удержали":
                c "Зарплата и аренда — два разных источника дохода, будка тут ни при чём."
                jump block1_choice2
                
            "Попросить своего работодателя удержать и с этого дохода тоже":
                g "Работодатель отвечает только за то, что платит сам, дружочек."
                jump block1_choice2
                
            "Самому подать декларацию 3-НДФЛ по итогам года и заплатить налог":
                c "Именно так — без декларации в этом случае никак."
                $ coins += 15
                jump block1_scene3

label block1_scene3:
    "🪙 +15 монет"
    
    scene bg stairs
    with dissolve
    
    "Посреди ярмарки — лестница из пяти неровных ступеней разной высоты, на каждой табличка со своим процентом."
    
    g "С 2025 года у нас не одна ставка НДФЛ, а целая лестница — пять ступеней. Смотри внимательно, мой дорогой:"
    g "до 2 400 000 ₽ в год — 13%"
    g "от 2 400 000 до 5 000 000 ₽ — 15% с суммы превышения"
    g "от 5 000 000 до 20 000 000 ₽ — 18% с суммы превышения"
    g "от 20 000 000 до 50 000 000 ₽ — 20% с суммы превышения"
    g "свыше 50 000 000 ₽ — 22% с суммы превышения"
    
    v "То есть если я заработал 3 миллиона, всё это облагается по 15%?"
    
    g "Нет-нет! Только та часть, что превышает порог. Первые 2 400 000 ₽ всё равно по 13%, и лишь оставшиеся 600 000 ₽ — уже по 15%."
    
    # ВЫБОР 5
    label block1_choice3:
        menu:
            "Доход Валеры за год — 3 000 000 ₽. Как считается его НДФЛ?"
            
            "15% на всю сумму сразу":
                c "Лестница ступенчатая — с этой ступеньки платят не все сразу, а только та часть, что до неё дотянулась."
                jump block1_choice3
                
            "13% на всё, раз доход меньше 5 000 000 ₽":
                g "Порог для 13% — это 2 400 000, а не 5 000 000, дружочек."
                jump block1_choice3
                
            "13% на первые 2 400 000 ₽ и 15% на оставшиеся 600 000 ₽":
                g "Точно! 2 400 000 × 13% + 600 000 × 15% = 312 000 + 90 000 = 402 000 ₽ налога."
                $ coins += 20
                jump block1_scene4

label block1_scene4:
    "🪙 +20 монет"
    
    scene bg cabinet
    with dissolve
    
    "В центре ярмарки — небольшой павильон с вывеской «Личный кабинет налогоплательщика», внутри мягко светится экран."
    
    c "Запомни этот павильон — сюда мы будем возвращаться в каждой следующей главе. Все заявления, справки и уведомления о вычетах приходят именно туда, на сайт ФНС России."
    
    g "И ещё, прежде чем идти дальше — все правила, о которых мы говорим, действуют для налоговых резидентов РФ. Это те, кто провёл в России больше 183 дней за последние 12 месяцев. У нерезидентов ставки другие, в основном 30%, и вычеты им, как правило, не положены."
    
    "🪙 +10 монет"
    jump block_2

# ==========================================
# БЛОК 2. КРЫЛО НЕДВИЖИМОСТИ И ГАРАЖ С КОЛЁСАМИ
# ==========================================
label block_2:
    scene bg realty
    with fade
    
    "Просторное крыло дворца, заставленное стопками ипотечных договоров и связками ключей, которые сами позвякивают в воздухе."
    
    show cat full at left
    c "Здесь живут те, кто купил своё жильё. И тут государству тоже есть что тебе вернуть."
    v "Мы с женой в этом году взяли квартиру в ипотеку. На что можно рассчитывать?"
    
    show caterpillar at right
    g "На два отдельных вычета сразу, мой дорогой! Первый — за саму покупку: база 2 000 000 ₽, максимальный возврат 260 000 ₽. Второй — за уплаченные проценты по ипотеке: база уже 3 000 000 ₽, максимальный возврат 390 000 ₽."
    
    v "А если квартира дороже 2 миллионов?"
    
    g "Неважно, лимит есть лимит. Но! Раз вы в браке — оба супруга могут заявить вычет каждый на себя. Тогда семейный максимум по процентам вырастает почти до 1,3 млн ₽ на двоих."
    
    # ВЫБОР 6
    label block2_choice1:
        menu:
            "Валера и его жена купили квартиру в ипотеку за 6 000 000 ₽. Как выгоднее оформить вычет?"
            
            "Вычет заявляет только Валера один":
                c "Можно и так, но тогда вторая половина лимита просто сгорит зря."
                jump block2_choice1
                
            "Вычет не положен, раз квартира дороже 2 000 000 ₽":
                g "Лимит — это потолок для расчёта, а не запрет на вычет при более дорогой покупке."
                jump block2_choice1
                
            "Вычет заявляют оба супруга — так семейный лимит по процентам увеличивается":
                g "Именно! Вдвоём вы используете куда больше положенного лимита, чем поодиночке."
                $ coins += 20
                $ has_svidetelstvo = True
                jump block2_scene2

label block2_scene2:
    "🪙 +20 монет · получен предмет «Свидетельство о праве на вычет»"
    
    scene bg garage
    with dissolve
    
    "Гараж, где на одних весах стоят автомобильные ключи и связка ключей от квартиры."
    
    c "А вот тут — наоборот, о продаже. Здесь важно не прогадать со временем."
    g "Если продать имущество раньше минимального срока владения, придётся заплатить налог с дохода от продажи. Для недвижимости это обычно 5 лет, но 3 года — если жильё единственное, получено в наследство или в подарок от близкого родственника. Для машины срок — 3 года."
    
    v "А если раньше продал — совсем всё плохо?"
    
    g "Не совсем. Налог можно уменьшить вычетом: 1 000 000 ₽ для недвижимости, 250 000 ₽ для прочего имущества, включая машину. Или, если сохранились документы о покупке — вычесть сами расходы на покупку из дохода от продажи."
    
    # ВЫБОР 7
    label block2_choice2:
        menu:
            "У Валеры квартира не единственная, он владеет ей 4 года и хочет продать. Нужно ли платить налог?"
            
            "Нет, 4 года — вполне достаточно":
                c "Пять лет — это пять лет, дружок."
                jump block2_choice2
                
            "Срок владения тут вообще не имеет значения":
                c "Пять лет — это пять лет, дружок."
                jump block2_choice2
                
            "Да, минимальный срок для такой квартиры — 5 лет, значит налог платить придётся (но его можно уменьшить вычетом 1 000 000 ₽)":
                g "Всё верно. Раньше пяти лет для не единственного жилья — налог с разницы между продажей и вычетом или расходами на покупку."
                $ coins += 20
                jump block2_scene3

label block2_scene3:
    "🪙 +20 монет"
    
    "Гусеница Bugatti в последний раз затягивается и медленно уползает в высокую траву, оставляя за собой сизый дымный след."
    
    g "И ещё одно, прежде чем идти дальше. Помнишь лестницу из пяти ступеней, которую мы проходили на Ярмарке НДФЛ? С 2025 года ставка НДФЛ не всегда ровно 13% — у тех, кто зарабатывает существенно больше, часть дохода облагается уже по 15–22%."
    
    c "Так что если коллега с высокой зарплатой вдруг говорит, что вернул больше 13% от вычета — не спеши считать его хвастуном."
    
    "🪙 +10 монет"
    
    # Заглушка для Блока 3
    "【Здесь будет Блок 3 «Инвестиционные продукты» — Биржевой пруд. Текст готовится】"
    jump block_4

# ==========================================
# БЛОК 4. СОЦИАЛЬНЫЕ БОНУСЫ
# ==========================================
label block_4:
    scene bg forest
    with fade
    
    "Лес, где вместо шишек с деревьев свисают детские свидетельства о рождении и справки из вуза."
    
    show cat smile
    c "У тебя есть дети, Валера?"
    v "Да, двое. Сын в школе, дочь — студентка, учится очно."
    
    c "Тогда этот лес шумит для тебя. Каждый месяц, пока твой доход с начала года не перевалит за 450 000 рублей, тебе полагается вычет на каждого."
    
    "Из-за куста медленно выплывают клубы дыма, а следом появляется и сама Гусеница Bugatti на своём грибе."
    
    show caterpillar
    g "Ах, молодой человек... Когда я была вычетом, я была намного меньше. До 2025 года на второго ребёнка давали всего 1400 рублей в месяц. Теперь — 2800. На третьего и последующих было 3000, стало 6000. Тяжёлые были времена..."
    
    v "А у меня сын — второй ребёнок в семье, дочь — первая. Сколько мне положено?"
    
    g "На первую — 1400 в месяц, на второго — 2800. Итого 4200 рублей вычета из налогооблагаемой базы каждый месяц, пока доход не достигнет 450 000 в год."
    
    # ВЫБОР 8
    label block4_choice1:
        menu:
            "Как Валере получить этот вычет?"
            
            "Пойти в налоговую и подать декларацию 3-НДФЛ":
                c "Можно и так, но зачем усложнять? Есть путь короче."
                jump block4_choice1
                
            "Ждать, пока налоговая сама пришлёт вычет":
                c "Этот вычет сам себя не найдёт — его получают через работодателя, а не ждут у моря погоды."
                jump block4_choice1
                
            "Обратиться в бухгалтерию/отдел кадров на работе":
                g "Именно так. Принеси в бухгалтерию копию свидетельства о рождении, для дочери — справку из вуза об очной форме, и заявление. Дальше зарплата сама станет немного больше."
                $ coins += 20
                $ has_zayavlenie_deti = True
                jump block4_scene2

label block4_scene2:
    "🪙 +20 монет · получен предмет «Заявление на детский вычет» · +4200 ₽/мес в копилку экономии"
    
    c "И запомни — если дочь учится очно, вычет на неё положен до 24 лет. Если ребёнок один, а родитель — единственный, вычет удваивается."
    
    scene bg gto
    with dissolve
    
    "Поляна со спортивными снарядами вперемешку с медицинскими кушетками — странное соседство, но тут так принято."
    
    show cat full at left
    c "А вот и моё любимое нововведение. С 2025 года государство платит тебе за заботу о себе."
