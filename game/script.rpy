# Ва# Валера в Стране Налогов - Сцена 0: Портал
init python:
    # Игровые переменные
    score = 0 # Монеты любопытства
    has_understood_deduction = False # Правило про 13%
    
image bg_portal = "bg_portal.png"
image valera normal = "valera_normal.png"
image cheshire_smile = "cheshire_smile.png" # Только улыбка
image cheshire_full = "cheshire_full.png" # Полный кот
image caterpillar_idle = "caterpillar_idle.png" # Спокойно сидит
image caterpillar_explain = "caterpillar_explain.png" # Объясняет
image caterpillar_applause = "caterpillar_applause.png" # Аплодирует
image caterpillar_nod = "caterpillar_nod.png" # Кивает головой
image caterpillar_wrong = "caterpillar_wrong.png" # Хмурится
image fair_bg = "fair_bg.png" # Фон ярмарки
image realty_bg = "realty_bg.png" # Крыло недвижимости
image parent_forest = "parent_forest.png" # Родительский лес
image gto_field = "gto_field.png" # ГТО-поляна
image social_forest = "social_forest.png" # Лес социальных забот
image archive_room = "archive_room.png" # Архив справок
image cashback_palace = "cashback_palace.png" # Дворец кешбека
image chest_end = "chest_end.png" # Финал, сундук

style window.background_color = "#ffffffaa"
style window.border_width = 0

define v = Character("Валера", color="#000")
define c = Character("Чеширский Кот", color="#ffb300") # Оранжевый
define cat = Character("Гусеница Bugatti", color="#66ccff") # Голубой

label start:
    scene black with fade
    play music "office_ambient.mp3" loop
    $ renpy.pause(1.0)

    scene bg_portal with dissolve
    show valera at center:
        xalign 0.5 yalign 0.7
        
    "Обычный опенспейс, вечер пятницы."
    "На экране Валеры всплывает файл «Налоговый_вычет.exe» с подмигивающей иконкой."
    
    v "Хм, что это ещё за файл? Я такой не сохранял..."
    
    pause 1.0
    
    # Эффект падения
    hide valera
    $ renpy.transition(dissolve)
    scene none with vpunch
    "Клик. Экран темнеет, пол уходит из-под ног."
    "Валера падает — мимо пролетают квитанции, справки 2-НДФЛ, бланки деклараций 3-НДФЛ, монетки с чьим-то рыжим профилем."
    
    voice "Падать вечно нельзя, дружок. Рано или поздно долетишь до сути."
    
    scene bg_portal with fade
    show valera at center
    
    "Валера приземляется на мягкую кипу документов."
    
    # Появление Кота по частям
    show cheshire_smile at right:
        xalign 1.0 yalign 0.3
    pause 1.0
    show cheshire_full at right:
        xalign 1.0 yalign 0.3
        
    c "Добро пожаловать в Страну Налогов, Валера. Тут всё как у вас, только выгоднее — если знать, куда смотреть."
    
    v "Погоди, а ты кто? И где я?"
    
    c "Я — тот, кто всегда рядом, даже когда меня не видно. А ты — там, где государство наконец готово вернуть тебе твои же деньги. Осталось только не упустить момент."
    
    v "Звучит подозрительно просто."
    
    c "О, поверь, бюрократии тут хватало. Но с 2024 года многое изменилось — карту почитай."
    
    menu:
        "А зачем мне вообще это надо, я и так неплохо живу":
            c "(прищуривается) Неплохо — не значит по максимуму. Тысячи рублей просто лежат там, где ты их не забираешь."
            jump portal_choice_retry
            
        "А можно получить вычет, если я вообще ничего не тратил?":
            c "(смеётся, обвивается хвостом вокруг ветки) Вычет — это возврат уже уплаченного налога с твоих трат. Не потратил — нечего возвращать. Но ты наверняка тратился — на детей, лечение, учёбу..." 
            jump portal_choice_bypass
            
        "Хорошо, показывай дорогу":
            c "(вскакивает, задняя половина туловища тает в воздухе первой) Тогда за мной. Первая остановка — Родительский лес."
            $ score += 10
            "[🪙 +10 монет любопытства]"
            jump prologue_rule_explanation
            
label portal_choice_retry:
    c "Подумай еще раз."
    jump start # Возвращаемся к началу диалога перед выбором

label portal_choice_bypass:
    jump prologue_rule_explanation

label prologue_rule_explanation:
    scene bg_portal
    show valera at center
    show cheshire_full at right
    
    c "Погоди-ка, прежде чем мы пойдём глубже — запомни одну вещь, а то потом собьёшься со счёта."
    v "Какую?"
    
    c "Из каждого рубля твоей зарплаты налоговая ещё до того, как деньги попадут к тебе, забирает 13 копеек — это налог на доходы. Вычет — это не деньги, которые тебе дарят сверху. Это сумма, с которой налоговая обещает не забирать свои 13 копеек."
    
    show caterpillar_idle at left:
        xalign 0.0 yalign 0.7
        
    cat "Проще говоря: вычет 100 000 ₽ — вернётся 13 000 ₽. Вычет 150 000 ₽ — вернётся 19 500 ₽. Всегда 13% от вычета, а не сам вычет целиком."
    
    v "То есть когда я слышу «вычет 150 000», это не 150 000 рублей мне на карту?"
    
    cat "Именно так, дружочек. И ещё: получить вычет может только тот, кто платит НДФЛ 13% — то есть официально работает. Самозанятые и ИП на УСН в этой сказке, увы, не участвуют."
    
    $ has_understood_deduction = True
    
    menu:
        "Валере положен вычет 150 000 ₽ на лечение. Сколько реально вернётся ему на счёт?":
            "150 000 ₽":
                c "Это база, а не возврат. Пересчитай через 13%."
                jump deduction_quiz_retry
                
            "13 000 ₽":
                cat "Это 13% от 100 000, а у нас 150 000."
                jump deduction_quiz_retry
                
            "19 500 ₽":
                c "(довольно кивает) Вот теперь считаешь правильно. 150 000 × 13% = 19 500 ₽."
                $ score += 15
                "[🪙 +15 монет · получено правило «Вычет = база, а не возврат»]"
                jump block1_fair_start
                
label deduction_quiz_retry:
    c "Попробуй снова."
    jump prologue_rule_explanation


# БЛОК 1: Ярмарка НДФЛ
label block1_fair_start:
    scene fair_bg with dissolve
    show valera at center
    show cheshire_full at right
    
    c "Добро пожаловать на Ярмарку НДФЛ. Это главный налог, который касается тебя каждый месяц, даже если ты о нём не думаешь."
    
    v "А что вообще под него попадает? Только зарплата?"
    
    show caterpillar_idle at left
    
    cat "О, гораздо больше, мой дорогой. Зарплата, премии, доход от сдачи квартиры в аренду, продажа имущества, выигрыши, дивиденды по акциям — всё это доход, а с дохода физлица берут НДФЛ."
    
    menu:
        "Валера в отпуске выиграл в лотерею 50 000 ₽. Нужно ли платить с этого НДФЛ?":
            "Нет, это же не зарплата":
                c "(усмехается) Прилавок с выигрышами тоже кидает монетку в мешок, не сомневайся."
                jump ndfl_quiz_retry
                
            "Только если выигрыш больше 1 000 000 ₽":
                cat "Не совсем так работает порог, дружочек. Выигрыш облагается налогом почти всегда."
                jump ndfl_quiz_retry
                
            "Да, это тоже доход — и с него тоже удерживается налог":
                cat "Именно. Доход есть доход, откуда бы он ни пришёл."
                $ score += 15
                "[🪙 +15 монет]"
                jump ndfl_agent
                
label ndfl_quiz_retry:
    c "Давай попробуем ещё раз."
    jump block1_fair_start

label ndfl_agent:
    scene fair_bg
    show valera at center
    show cheshire_full at right
    
    c "Видишь эту будку? Это твой работодатель — он тут называется налоговым агентом."
    
    v "В смысле, налоговым агентом? Он же просто платит мне зарплату."
    
    c "И одновременно сам удерживает налог и перечисляет его в бюджет — тебе для этого ничего подавать не нужно. С зарплаты всё происходит автоматически."
    
    cat "(кивает) А вот с другими доходами — не так. Если сдаёшь квартиру и деньги идут прямо тебе на карту, никто за тебя налог не удержит. Придётся подавать декларацию 3-НДФЛ самостоятельно, по итогам года."
    
    menu:
        "Валера сдаёт квартиру в аренду, деньги приходят напрямую ему на карту. Что делать с налогом?":
            "Ничего, раз с зарплаты уже всё удержали":
                c "(качает головой) Зарплата и аренда — два разных источника дохода, будка тут ни при чём."
                jump agent_quiz_retry
                
            "Самому подать декларацию 3-НДФЛ по итогам года и заплатить налог":
                c "(одобрительно кивает) Именно так — без декларации в этом случае никак."
                $ score += 15
                "[🪙 +15 монет]"
                jump ndfl_stairs
                
            "Попросить своего работодателя удержать и с этого дохода тоже":
                cat "(поправляет трубку) Работодатель отвечает только за то, что платит сам, дружочек."
                jump agent_quiz_retry
                
label agent_quiz_retry:
    c "Думаю, стоит попробовать другой вариант."
    jump ndfl_agent

label ndfl_stairs:
    scene fair_bg
    show valera at center
    show caterpillar_explain at left
    
    cat "С 2025 года у нас не одна ставка НДФЛ, а целая лестница — пять ступеней. Смотри внимательно:"
    cat "до 2 400 000 ₽ в год — 13%\nот 2 400 000 до 5 000 000 ₽ — 15% с суммы превышения\nот 5 000 000 до 20 000 000 ₽ — 18% с суммы превышения\nот 20 000 000 до 50 000 000 ₽ — 20% с суммы превышения\nсвыше 50 000 000 ₽ — 22% с суммы превышения"
    
    v "То есть если я заработал 3 миллиона, всё это облагается по 15%?"
    
    cat "Нет-нет! Только та часть, что превышает порог. Первые 2 400 000 ₽ всё равно по 13%, и лишь оставшиеся 600 000 ₽ — уже по 15%."
    
    menu:
        "Доход Валеры за год — 3 000 000 ₽. Как считается его НДФЛ?":
            "15% на всю сумму сразу":
                c "(качает головой) Лестница ступенчатая — с этой ступеньки платят не все сразу, а только та часть, что до неё дотянулась."
                jump stairs_quiz_retry
                
            "13% на первые 2 400 000 ₽ и 15% на оставшиеся 600 000 ₽":
                cat "(аплодирует) Точно! 2 400 000 × 13% + 600 000 × 15% = 312 000 + 90 000 = 402 000 ₽ налога."
                $ score += 20
                "[🪙 +20 монет]"
                jump ndfl_citizenship
                
            "13% на всё, раз доход меньше 5 000 000 ₽":
                cat "Порог для 13% — это 2 400 000, а не 5 000 000, дружочек."
                jump stairs_quiz_retry
                
label stairs_quiz_retry:
    c "Давайте проверим математику ещё раз."
    jump ndfl_stairs

label ndfl_citizenship:
    scene fair_bg
    show valera at center
    show cheshire_full at right
    
    c "Запомни этот павильон — сюда мы будем возвращаться в каждой следующей главе. Все заявления, справки и уведомления о вычетах приходят именно туда, на сайт ФНС России."
    
    cat "(медленно затягиваясь трубкой) И ещё, прежде чем идти дальше — все правила, о которых мы говорим, действуют для налоговых резидентов РФ. Это те, кто провёл в России больше 183 дней за последние 12 месяцев. У нерезидентов ставки другие, в основном 30%, и вычеты им, как правило, не положены."
    
    "$ score += 10"
    "[🪙 +10 монет]"
    
    c "Ну что, пора двигаться дальше. Следующая станция — крыло Недвижимости!"
    jump block2_realty_start


# БЛОК 2: Крыло Недвижимости и Гараж с Колёсами
label block2_realty_start:
    scene realty_bg with dissolve
    show valera at center
    show cheshire_full at right
    
    c "Здесь живут те, кто купил своё жильё. И тут государству тоже есть что тебе вернуть."
    
    v "Мы с женой в этом году взяли квартиру в ипотеку. На что можно рассчитывать?"
    
    show caterpillar_explain at left
    
    cat "На два отдельных вычета сразу, мой дорогой! Первый — за саму покупку: база 2 000 000 ₽, максимальный возврат 260 000 ₽. Второй — за уплаченные проценты по ипотеке: база уже 3 000 000 ₽, максимальный возврат 390 000 ₽."
    
    v "А если квартира дороже 2 миллионов?"
    
    cat "Неважно, лимит есть лимит. Но! Раз вы в браке — оба супруга могут заявить вычет каждый на себя. Тогда семейный максимум по процентам вырастает почти до 1,3 млн ₽ на двоих."
    
    menu:
        "Валера и его жена купили квартиру в ипотеку за 6 000 000 ₽. Как выгоднее оформить вычет?":
            "Вычет заявляет только Валера один":
                c "(прищуривается) Можно и так, но тогда вторая половина лимита просто сгорит зря."
                jump realty_quiz_retry
                
            "Вычет заявляют оба супруга — так семейный лимит по процентам увеличивается":
                cat "(аплодирует) Именно! Вдвоём вы используете куда больше положенного лимита, чем поодиночке."
                $ score += 20
                "[🪙 +20 монет · получен предмет «Свидетельство о праве на вычет»]"
                jump realty_sale
                
            "Вычет не положен, раз квартира дороже 2 000 000 ₽":
                cat "(качает головой) Лимит — это потолок для расчёта, а не запрет на вычет при более дорогой покупке."
                jump realty_quiz_retry
                
label realty_quiz_retry:
    c "Может быть, стоит рассмотреть другие варианты?"
    jump block2_realty_start

label realty_sale:
    scene realty_bg
    show valera at center
    show cheshire_full at right
    
    c "А вот тут — наоборот, о продаже. Здесь важно не прогадать со временем."
    
    cat "Если продать имущество раньше минимального срока владения, придётся заплатить налог с дохода от продажи. Для недвижимости это обычно 5 лет, но 3 года — если жильё единственное, получено в наследство или в подарок от близкого родственника. Для машины срок — 3 года."
    
    v "А если раньше продал — совсем всё плохо?"
    
    cat "Не совсем. Налог можно уменьшить вычетом: 1 000 000 ₽ для недвижимости, 250 000 ₽ для прочего имущества, включая машину. Или, если сохранились документы о покупке — вычесть сами расходы на покупку из дохода от продажи."
    
    menu:
        "У Валеры квартира не единственная, он владеет ей 4 года и хочет продать. Нужно ли платить налог?":
            "Нет, 4 года — вполне достаточно":
                c "(качает головой) Пять лет — это пять лет, дружок."
                jump sale_quiz_retry
                
            "Срок владения тут вообще не имеет значения":
                c "(хмурится) Срок очень важен. Без соблюдения минимума налог неизбежен."
                jump sale_quiz_retry
                
            "Да, минимальный срок для такой квартиры — 5 лет, значит налог платить придётся (но его можно уменьшить вычетом 1 000 000 ₽)":
                cat "(кивает) Всё верно. Раньше пяти лет для не единственного жилья — налог с разницы между продажей и вычетом или расходами на покупку."
                $ score += 20
                "[🪙 +20 монет]"
                jump block4_parents
                
label sale_quiz_retry:
    c "Стоит проверить условия ещё раз."
    jump realty_sale


# БЛОК 4: Социальные бонусы
label block4_parents:
    scene parent_forest with dissolve
    show valera at center
    show cheshire_full at right
    
    c "У тебя есть дети, Валера?"
    
    v "Да, двое. Сын в школе, дочь — студентка, учится очно."
    
    c "Тогда этот лес шумит для тебя. Каждый месяц, пока твой доход с начала года не перевалит за 450 000 рублей, тебе полагается вычет на каждого."
    
    show caterpillar_explain at left
    
    cat "Ах, молодой человек... Когда я была вычетом, я была намного меньше. До 2025 года на второго ребёнка давали всего 1400 рублей в месяц. Теперь — 2800. На третьего и последующих было 3000, стало 6000. Тяжёлые были времена..."
    
    v "А у меня сын — второй ребёнок в семье, дочь — первая. Сколько мне положено?"
    
    cat "На первую — 1400 в месяц, на второго — 2800. Итого 4200 рублей вычета из налогооблагаемой базы каждый месяц, пока доход не достигнет 450 000 в год."
    
    menu:
        "Как Валере получить этот вычет?":
            "Пойти в налоговую и подать декларацию 3-НДФЛ":
                c "(качает головой) Можно и так, но зачем усложнять? Есть путь короче."
                jump parents_quiz_retry
                
            "Ждать, пока налоговая сама пришлёт вычет":
                c "(подмигивает) Этот вычет сам себя не найдёт — его получают через работодателя, а не ждут у моря погоды."
                jump parents_quiz_retry
                
            "Обратиться в бухгалтерию/отдел кадров на работе":
                cat "(кивает) Именно так. Принеси в бухгалтерию копию свидетельства о рождении, для дочери — справку из вуза об очной форме, и заявление. Дальше зарплата сама станет немного больше."
                $ score += 20
                "[🪙 +20 монет · получен предмет «Заявление на детский вычет» · +4200 ₽/мес в копилку экономии]"
                jump block4_gto
                
label parents_quiz_retry:
    c "Есть более простой способ."
    jump block4_parents

label block4_gto:
    scene gto_field with dissolve
    show valera at center
    show cheshire_full at right
    
    c "А вот и моё любимое нововведение. С 2025 года государство платит тебе за заботу о себе."
    
    v "В смысле платит? Мне зарплату повысят, если я отожмусь?"
    
    c "Почти. Сдай нормы ГТО, получи знак отличия — и пройди диспансеризацию в том же году. Вот тогда вычет твой."
    
    cat "(выпускает дымное колечко с % внутри) Именно в том же году, юноша, это важно! Если диспансеризацию прошли в 2025-м, а ГТО сдали только в 2026-м — вычет не дадут. Годы должны совпасть."
    
    v "И сколько за это дают?"
    
    cat "18 000 рублей в год. И это отдельный вычет — он не съедает лимит других социальных вычетов, можно заявлять вместе с детским или вычетом на обучение."
    
    menu:
        "Валера в этом году сдал ГТО в марте, а диспансеризацию прошёл в декабре прошлого года. Получит он вычет?":
            "Да, оба события были":
                cat "(грустно качает головой) Увы. Правило простое — оба события в одном календарном году."
                jump gto_quiz_retry
                
            "Да, если попросит по-хорошему":
                c "(смеётся) Государственные правила не зависят от просьб."
                jump gto_quiz_retry
                
            "Нет, годы должны совпадать":
                cat "(кивает) Верно! Получить этот вычет можно у работодателя, единовременно, в любом месяце — просто принеси документы."
                $ score += 20
                "[🪙 +20 монет]"
                jump block4_social
                
label gto_quiz_retry:
    c "Правило простое: оба действия должны быть в одном году."
    jump block4_gto

label block4_social:
    scene social_forest with dissolve
    show valera at center
    show cheshire_full at right
    
    c "Здесь всё, на что ты обычно тратишься сам, не задумываясь, что государство готово вернуть часть денег. Учёба, лечение, фитнес — общий лимит вычета 150 000 рублей в год."
    
    v "А это на всё сразу или на каждое отдельно?"
    
    c "Общий котёл. Раньше было 120 000, с 2024 года — уже 150 000."
    
    cat "(затягивается) В этот же лимит входят взносы на пенсионное страхование и накопительную пенсию. А вот обучение детей считается отдельно — до 110 000 рублей на каждого ребёнка, было 50 000. И это на семью, а не на каждого родителя!"
    
    v "А если я лечу зубы имплантами — это тоже в лимит 150 000?"
    
    cat "(строго) Дорогостоящее лечение — как имплантация зубов или ЭКО — вообще не ограничено лимитом. Можно принять к вычету полную сумму."
    
    menu:
        "Валера в этом году потратил: 40 000 ₽ на своё обучение, 90 000 ₽ на фитнес для себя, и 80 000 ₽ на обучение сына (очно, единственный ребёнок). Сколько войдёт в общий лимит, а сколько отдельно?":
            "Все 210 000 войдут в общий лимит":
                c "(качает головой) Обучение и лечение за себя — это один котёл, а за детей — отдельный."
                jump social_quiz_retry
                
            "Всё войдёт в лимит на ребёнка":
                c "(хмурится) Нет, траты на себя и на детей разделяются."
                jump social_quiz_retry
                
            "130 000 (обучение + фитнес) — в общий лимит 150 000, а 80 000 за сына — отдельно, в пределах 110 000 на ребёнка":
                cat "(аплодирует всеми лапками) Прекрасно! Именно так — траты Валеры на себя (130 000) укладываются в общий лимит 150 000, а 80 000 за сына — отдельно, в пределах 110 000 на ребёнка."
                $ score += 30
                "[🪙 +30 монет]"
                jump block4_archive
                
label social_quiz_retry:
    c "Нужно разделить траты на личные и детские."
    jump block4_social

label block4_archive:
    scene archive_room with dissolve
    show valera at center
    show cheshire_full at right
    
    c "Раньше здесь был хаос — договоры, чеки, лицензии для каждого вычета отдельно. Теперь порядок: одна справка на всё."
    
    v "Справка об оплате услуг?"
    
    c "Она самая. Клиника, школа, спортклуб — все выдают единый документ, который заменяет весь бумажный ворох. Но это только для трат после 1 января 2024 года."
    
    cat "(задумчиво выпускает цифру 2023) А вот за 2023-й — прости, дружочек, тут по старинке. Нужен полный комплект: договор, чеки, лицензия. Кстати, в этом, 2026 году, ещё можно подать на вычет сразу за 2023, 2024 и 2025 годы."
    
    menu:
        "Организация Валеры участвует в электронном обмене данными с налоговой. Что нужно сделать, чтобы получить вычет в упрощённом порядке?":
            "Собрать справки, чеки и лично отнести их в налоговую":
                c "(смеётся) Мы избавились от бумажной волокиты. Давай проще."
                jump archive_quiz_retry
                
            "Ничего, вычет придёт сам собой без всяких действий":
                cat "(качает головой) Подписать заявление всё же придётся — само оно не подтвердится."
                jump archive_quiz_retry
                
            "Дождаться предзаполненного заявления в Личном кабинете и просто подписать его":
                c "(довольно жмурится) Организация сама передаст данные — с твоего согласия. В марте следующего года жди сообщение в Личном кабинете на сайте ФНС. Осталось выбрать счёт и подписать электронной подписью."
                $ score += 25
                "[🪙 +25 монет]"
                jump block4_cashback
                
label archive_quiz_retry:
    c "Государство помогает упростить процесс, но твоя подпись нужна."
    jump block4_archive

label block4_cashback:
    scene cashback_palace with dissolve
    show valera at center
    show cheshire_full at right
    
    c "Добро пожаловать в самое новое крыло Страны Налогов. С 2026 года здесь раздают кешбэк — да-да, почти как в банке, только от государства."
    
    v "Кешбэк за налоги? Как это работает?"
    
    cat "Если в семье двое и более детей младше 18 лет (или до 23, если учатся очно), и средний доход на человека в семье ниже 1,5 прожиточного минимума в регионе — государство пересчитывает ваш налог по ставке 6% вместо обычных 13% и возвращает разницу."
    
    *[Далее идет пример с Геной]*
    
    menu:
        "Подходит ли Гена под кешбэк?":
            "Не подходит, доход слишком большой":
                c "(указывает на цифры) Посмотри внимательнее на расчет."
                jump cashback_quiz_retry
                
            "Невозможно посчитать без дополнительных данных":
                c "(качает головой) Данные уже приведены выше."
                jump cashback_quiz_retry
                
            "Подходит, доход ниже порога":
                cat "(радостно аплодирует) Верно! Сумма кешбэка — разница между налогом по 13% (188 500 ₽) и по 6% (87 000 ₽) — то есть 101 500 ₽ в год!"
                $ score += 30
                "[🪙 +30 монет · получен предмет «Заявление на кешбэк» · +101 500 ₽ (условный пример) в копилку]"
                jump end_game
                
label cashback_quiz_retry:
    c "Посмотрим на расчеты ещё раз."
    jump block4_cashback

# КОНЕЦ ИГРЫ
label end_game:
    scene chest_end with dissolve
    show valera at center
    show cheshire_full at right
    show caterpillar_idle at left
    
    c "Ну что, Валера, готов открыть?"
    
    v "А что внутри?"
    
    cat "Твои собственные деньги, мой дорогой. Просто раньше ты не знал, что дверца была не заперта."
    
    *$ renpy.pause(1.0)*
    
    "[🎁 Итог игры:]"
    "Ты собрал [score] монет любопытства и открыл для себя мир налоговых вычетов."
    "Теперь ты знаешь, как работают:"
    "- Стандартный налоговый вычет на детей"
    "- Вычет на покупку жилья и ипотечные проценты"
    "- Вычет на дорогостоящее лечение и социальные траты"
    "- Упрощённый порядок подачи заявлений"
    "- Прогрессивная шкала НДФЛ"
    "- Новый налоговый кешбэк для семей с детьми"
    
    c "(исчезая, остаётся только улыбка) Помни: вычет сам не придёт, если ты сам не протянешь руку. Увидимся в другой раз, Валера."
